/run/initialize

# Batch mode — no visualization, full step output to phonon_steps.txt
/tracking/verbose 2
/tracking/storeTrajectory 0

# G4CMP: produce both phonons and charges from the proton shower
/g4cmp/producePhonons 0.01
/g4cmp/produceCharges 0.01
/g4cmp/sampleLuke     0.01

# 120 GeV proton entering the slab from above (-Z face)
# Slab Z runs from -0.2625 mm to +0.2625 mm
# Proton fires downward in -Z direction from just above the slab
/gps/number 1
/gps/particle proton
/gps/pos/type Point
/gps/pos/centre 0.0 0.0 0.5 mm
/gps/direction 0 0 -1
/gps/ene/type Mono
/gps/energy 120 GeV
/run/beamOn 1
