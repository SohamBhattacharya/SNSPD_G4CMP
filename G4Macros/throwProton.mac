/run/initialize

# Create a scene handler
/vis/open OGL
/vis/viewer/set/upVector 0 1 0
/vis/viewer/set/viewpointVector 0 0 1
/vis/viewer/zoom 1.4
/vis/drawVolume

# For drawing the tracks
/tracking/verbose 2
/tracking/storeTrajectory 1
/vis/scene/endOfEventAction accumulate
/vis/scene/add/trajectories

# Safely create or select the trajectory model
# Using 'select' prevents the "gray reset" on subsequent runs
/vis/modeling/trajectories/create/drawByParticleID CMP_Colors
/vis/modeling/trajectories/select CMP_Colors

# Define particle colors cleanly before the beam runs
/vis/modeling/trajectories/CMP_Colors/set proton White
/vis/modeling/trajectories/CMP_Colors/set e- Yellow
/vis/modeling/trajectories/CMP_Colors/set G4CMPDriftElectron Violet
/vis/modeling/trajectories/CMP_Colors/set G4CMPDriftHole Orange
/vis/modeling/trajectories/CMP_Colors/set phononTS Red
/vis/modeling/trajectories/CMP_Colors/set phononTF Green
/vis/modeling/trajectories/CMP_Colors/set phononL Blue

# Rendering options
/vis/viewer/set/style wireframe
/vis/viewer/set/hiddenMarker true
/vis/viewer/set/viewpointThetaPhi 70 20
/vis/viewer/zoom 1.6

# G4CMP flags
/g4cmp/producePhonons 0.0000000000001
/g4cmp/produceCharges 0.0000000000001
/g4cmp/sampleLuke     0.0000000000001

# Particle generation
/gps/number 1
/gps/particle proton
/gps/pos/type Point
/gps/pos/centre 0.0 0.0 0.5 mm
/gps/direction 0 0 -1
/gps/ene/type Mono
/gps/energy 0.00005 GeV

# Run and force immediate viewer refresh
/run/beamOn 1
/vis/viewer/flush
/vis/viewer/set/viewpointThetaPhi 0 0
